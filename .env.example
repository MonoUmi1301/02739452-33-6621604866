```dotenv
# PostgreSQL Configuration
POSTGRES_DB=cyber_vulnerability_db
POSTGRES_USER=cyber_user
POSTGRES_PASSWORD=change_this_password

# Database Connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cyber_vulnerability_db
DB_USER=cyber_user
DB_PASSWORD=

AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# NVD API Configuration
NVD_API_KEY=

# GitHub Advisory Database
GITHUB_TOKEN=

# Vulnerability Filtering
CVSS_MIN_SCORE=9.0
LOOKBACK_DAYS=60

# Web Dashboard
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
```